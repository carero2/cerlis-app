rules_version = '2';

// Reglas de seguridad de Cerlis.
// Solo las cuentas de Google de esta lista pueden leer o escribir la lista de
// la compra y las recetas. Cualquier otra cuenta (o alguien sin sesión) no
// puede ver ni tocar nada, aunque tenga el enlace de la app.
//
// ⚠️ Sustituye los dos correos de ejemplo por los vuestros, en minúsculas,
// al pegar estas reglas en la consola de Firebase (Firestore → Reglas).
// No hace falta que los correos reales estén en GitHub.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'tu.correo@gmail.com',
          'correo.de.tu.pareja@gmail.com'
        ];
    }

    match /items/{itemId} {
      allow read, write: if allowed();
    }

    match /recipes/{recipeId} {
      allow read, write: if allowed();
    }

    // Fotos grandes (las miniaturas van dentro de cada producto o receta).
    // Firestore admite como máximo ~1 MB por documento.
    match /photos/{photoId} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
    }

    // Personalización compartida de Inicio (foto, mensaje y cuenta atrás).
    match /settings/{settingId} {
      allow read, write: if allowed();
    }

    // Todo lo demás queda cerrado.
  }
}

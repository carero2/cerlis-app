# Copia este archivo (o .env.production) a .env.local y rellénalo con la configuración web de tu
# proyecto de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps).
# Si se deja vacío, la app funciona en modo local (solo en este dispositivo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
